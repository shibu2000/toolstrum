{
  "expo": {
    "name": "Toolstrum",
    "slug": "toolstrum",
    "version": "1.0.1",
    "scheme": "toolstrum",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "primaryColor": "#4F46E5",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.toolstrum.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Toolstrum saves processed images, video and audio to your photo library when you choose to.",
        "NSPhotoLibraryAddUsageDescription": "Toolstrum saves processed images, video and audio to your photo library when you choose to.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "package": "com.toolstrum.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Toolstrum",
      "shortName": "Toolstrum"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          },
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-audio",
      "expo-asset",
      [
        "expo-media-library",
        {
          "photosPermission": "Toolstrum saves processed images, video and audio to your photo library when you choose to.",
          "savePhotosPermission": "Toolstrum saves processed images, video and audio to your photo library when you choose to.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0f448f27-041f-4aa9-85bf-9c32e4558f1e"
      }
    }
  }
}
