{
  "expo": {
    "name": "Toolstrum",
    "slug": "toolstrum",
    "version": "1.0.0",
    "scheme": "toolstrum",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.toolstrum.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Toolstrum saves edited videos to your photo library when you choose to."
      }
    },
    "android": {
      "package": "com.toolstrum.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Toolstrum",
      "shortName": "Toolstrum"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "0f448f27-041f-4aa9-85bf-9c32e4558f1e"
      }
    }
  }
}
